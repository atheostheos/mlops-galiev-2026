{
  "version": 1,
  "disable_existing_loggers": false,
  "filters": {
    "request_id": {
      "()": "src.logging_setup.RequestIDFilter"
    }
  },
  "formatters": {
    "standard": {
      "format": "%(asctime)s %(levelname)-8s %(name)s [%(request_id)s] | %(message)s",
      "datefmt": "%Y-%m-%d %H:%M:%S"
    }
  },
  "handlers": {
    "console": {
      "class": "logging.StreamHandler",
      "stream": "ext://sys.stdout",
      "formatter": "standard",
      "filters": ["request_id"]
    }
  },
  "loggers": {
    "uvicorn": {
      "handlers": ["console"],
      "level": "INFO",
      "propagate": false
    },
    "uvicorn.error": {
      "handlers": ["console"],
      "level": "INFO",
      "propagate": false
    },
    "uvicorn.access": {
      "handlers": ["console"],
      "level": "INFO",
      "propagate": false
    }
  },
  "root": {
    "handlers": ["console"],
    "level": "INFO"
  }
}
